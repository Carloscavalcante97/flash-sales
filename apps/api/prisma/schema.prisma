generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Sale {
  id     String  @id @default(uuid())
  name   String
  stock  Int     // units still available; decremented by each reservation
  orders Order[]

  @@map("sales")
}

enum OrderStatus {
  RESERVED
}

model Order {
  id      String      @id @default(uuid())
  saleId  String
  buyerId String
  status  OrderStatus @default(RESERVED)
  sale    Sale        @relation(fields: [saleId], references: [id])

  @@map("orders")
}

// F02: one row per Idempotency-Key. status/body are written in the same
// transaction that claims the key, so a committed row always has both.
model IdempotencyKey {
  key     String @id
  saleId  String
  buyerId String // JSON.stringify(buyerId): lossless even for lone surrogates
  status  Int?
  body    Json?  @db.Json // json, not jsonb: keeps the stored body byte-for-byte (key order)

  @@map("idempotency_keys")
}
